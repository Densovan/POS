# Copy this file to .env and fill in real values.
# Never commit .env to git.

# ---- Database (docker-compose postgres + app) ----
POSTGRES_DB=pos_db
POSTGRES_USER=pos_user
POSTGRES_PASSWORD=change-me-strong-password

DB_HOST=db
# Port INSIDE the docker network. Keep 5432 here.
# The host port (for pgAdmin/DBeaver on your machine) is the left side
# of the ports mapping in docker-compose.yml (currently 5434:5432).
DB_PORT=5432
DB_NAME=pos_db
DB_USERNAME=pos_user
DB_PASSWORD=change-me-strong-password
DDL_AUTO=validate

# ---- Redis ----
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

# ---- Mail (SMTP) ----
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=

# ---- JWT (REQUIRED - no default) ----
# Generate with: openssl rand -base64 64
JWT_SECRET=
JWT_EXPIRATION=900000
REFRESH_TOKEN_EXPIRATION=604800000

# ---- Server / Logging ----
SERVER_PORT=8080
SHOW_SQL=false
LOG_LEVEL=INFO
LOG_LEVEL_POS=DEBUG

# ---- CORS ----
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:4200

# ---- POS Settings ----
SHOP_NAME=My Store
SHOP_ADDRESS=123 Main Street
SHOP_PHONE=+855 12 345 678
SHOP_EMAIL=info@mystore.com
SHOP_TAX_ID=123456789
CURRENCY_SYMBOL=$
CURRENCY_CODE=USD
RECEIPT_HEADER=Thank you for shopping!
RECEIPT_FOOTER=Please come again!
BARCODE_TYPE=CODE128
DEFAULT_PRINTER=
KITCHEN_PRINTER=
CASH_DRAWER_PORT=COM1
